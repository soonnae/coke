[
    {
        "id": "plc_dashboard_tab",
        "type": "tab",
        "label": "Ship Engine HMI",
        "disabled": false,
        "info": "Control Zone PLC Dashboard for Ship Engine Monitoring"
    },
    {
        "id": "ui_group_engine",
        "type": "ui_group",
        "name": "Engine Status",
        "tab": "ui_tab_main",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "ui_group_controls",
        "type": "ui_group",
        "name": "Controls",
        "tab": "ui_tab_main",
        "order": 2,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "ui_tab_main",
        "type": "ui_tab",
        "name": "Ship Engine Control",
        "icon": "dashboard",
        "order": 1,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "poll_plc_status",
        "type": "inject",
        "z": "plc_dashboard_tab",
        "name": "Poll every 2s",
        "props": [{"p": "payload"}],
        "repeat": "2",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 130,
        "y": 100,
        "wires": [["http_get_plc_status"]]
    },
    {
        "id": "http_get_plc_status",
        "type": "http request",
        "z": "plc_dashboard_tab",
        "name": "GET /api/plc/status",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://localhost:8080/api/plc/status",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 350,
        "y": 100,
        "wires": [["parse_plc_data"]]
    },
    {
        "id": "parse_plc_data",
        "type": "function",
        "z": "plc_dashboard_tab",
        "name": "Parse PLC Data",
        "func": "// Extract sensor data and control data from API response\nconst data = msg.payload;\n\n// Create separate messages for each gauge\nreturn [\n    { payload: data.engine.rpm },\n    { payload: data.engine.temperature },\n    { payload: data.fuel.level },\n    { payload: data.control.ballast },\n    { payload: data.control.pump_mode },\n    { payload: data.connected ? \"Connected\" : \"Disconnected\" }\n];",
        "outputs": 6,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 100,
        "wires": [
            ["gauge_rpm"],
            ["gauge_temperature"],
            ["gauge_fuel"],
            ["gauge_ballast"],
            ["text_pump_mode"],
            ["text_connection"]
        ]
    },
    {
        "id": "gauge_rpm",
        "type": "ui_gauge",
        "z": "plc_dashboard_tab",
        "name": "Engine RPM",
        "group": "ui_group_engine",
        "order": 1,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Engine RPM",
        "label": "RPM",
        "format": "{{value}}",
        "min": 0,
        "max": "2000",
        "colors": ["#00b500", "#e6e600", "#ca3838"],
        "seg1": "800",
        "seg2": "1200",
        "x": 810,
        "y": 60,
        "wires": []
    },
    {
        "id": "gauge_temperature",
        "type": "ui_gauge",
        "z": "plc_dashboard_tab",
        "name": "Engine Temperature",
        "group": "ui_group_engine",
        "order": 2,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Engine Temperature",
        "label": "°C",
        "format": "{{value}}",
        "min": 0,
        "max": "120",
        "colors": ["#00b500", "#e6e600", "#ca3838"],
        "seg1": "80",
        "seg2": "100",
        "x": 820,
        "y": 100,
        "wires": []
    },
    {
        "id": "gauge_fuel",
        "type": "ui_gauge",
        "z": "plc_dashboard_tab",
        "name": "Fuel Level",
        "group": "ui_group_engine",
        "order": 3,
        "width": 0,
        "height": 0,
        "gtype": "donut",
        "title": "Fuel Level",
        "label": "%",
        "format": "{{value}}",
        "min": 0,
        "max": "100",
        "colors": ["#ca3838", "#e6e600", "#00b500"],
        "seg1": "20",
        "seg2": "50",
        "x": 820,
        "y": 140,
        "wires": []
    },
    {
        "id": "gauge_ballast",
        "type": "ui_gauge",
        "z": "plc_dashboard_tab",
        "name": "Ballast Level",
        "group": "ui_group_engine",
        "order": 4,
        "width": 0,
        "height": 0,
        "gtype": "donut",
        "title": "Ballast Level",
        "label": "",
        "format": "{{value}}",
        "min": "40",
        "max": "50",
        "colors": ["#ca3838", "#e6e600", "#00b500"],
        "seg1": "43",
        "seg2": "47",
        "x": 820,
        "y": 180,
        "wires": []
    },
    {
        "id": "text_pump_mode",
        "type": "ui_text",
        "z": "plc_dashboard_tab",
        "name": "Pump Mode",
        "group": "ui_group_engine",
        "order": 5,
        "width": 0,
        "height": 0,
        "label": "Pump Mode",
        "format": "{{msg.payload === 1 ? 'FILL' : msg.payload === -1 ? 'DRAIN' : 'HOLD'}}",
        "layout": "row-spread",
        "x": 810,
        "y": 220,
        "wires": []
    },
    {
        "id": "text_connection",
        "type": "ui_text",
        "z": "plc_dashboard_tab",
        "name": "Connection Status",
        "group": "ui_group_engine",
        "order": 6,
        "width": 0,
        "height": 0,
        "label": "PLC Connection",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 830,
        "y": 260,
        "wires": []
    },
    {
        "id": "button_pump_toggle",
        "type": "ui_button",
        "z": "plc_dashboard_tab",
        "name": "Toggle Pump",
        "group": "ui_group_controls",
        "order": 1,
        "width": 0,
        "height": 0,
        "passthru": false,
        "label": "Toggle Pump",
        "tooltip": "",
        "color": "",
        "bgcolor": "",
        "icon": "power_settings_new",
        "payload": "",
        "payloadType": "str",
        "topic": "",
        "x": 130,
        "y": 300,
        "wires": [["http_post_toggle_pump"]]
    },
    {
        "id": "http_post_toggle_pump",
        "type": "http request",
        "z": "plc_dashboard_tab",
        "name": "POST /api/plc/pump/toggle",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://localhost:8080/api/plc/pump/toggle",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 380,
        "y": 300,
        "wires": [["notify_toggle_result"]]
    },
    {
        "id": "notify_toggle_result",
        "type": "ui_toast",
        "z": "plc_dashboard_tab",
        "position": "top right",
        "displayTime": "3",
        "highlight": "",
        "sendall": true,
        "outputs": 0,
        "ok": "OK",
        "cancel": "",
        "raw": false,
        "topic": "",
        "name": "Pump Toggle Notification",
        "x": 660,
        "y": 300,
        "wires": []
    },
    {
        "id": "slider_rpm",
        "type": "ui_slider",
        "z": "plc_dashboard_tab",
        "name": "Set RPM",
        "label": "Target RPM",
        "tooltip": "",
        "group": "ui_group_controls",
        "order": 2,
        "width": 0,
        "height": 0,
        "passthru": true,
        "outs": "end",
        "topic": "",
        "min": "500",
        "max": "2000",
        "step": "50",
        "x": 120,
        "y": 360,
        "wires": [["prepare_rpm_write"]]
    },
    {
        "id": "prepare_rpm_write",
        "type": "function",
        "z": "plc_dashboard_tab",
        "name": "Prepare Register Write",
        "func": "msg.payload = {\n    address: 0,\n    value: msg.payload\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 360,
        "wires": [["http_post_write_register"]]
    },
    {
        "id": "http_post_write_register",
        "type": "http request",
        "z": "plc_dashboard_tab",
        "name": "POST /api/plc/write_register",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://localhost:8080/api/plc/write_register",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "x": 610,
        "y": 360,
        "wires": [[]]
    },
    {
        "id": "comment_instructions",
        "type": "comment",
        "z": "plc_dashboard_tab",
        "name": "Ship Engine HMI - Installation Instructions",
        "info": "# Node-RED Setup Instructions\n\n## 1. Install Required Nodes\n```bash\ncd ~/.node-red\nnpm install node-red-dashboard\n```\n\n## 2. Import This Flow\n1. Open Node-RED (http://localhost:1880)\n2. Menu → Import → Clipboard\n3. Paste the contents of this JSON file\n4. Click 'Import'\n\n## 3. Start HMI Bridge\n```bash\npython control/hmi_bridge.py\n```\n\n## 4. Access Dashboard\nhttp://localhost:1880/ui\n\n## 5. API Endpoints\n- GET  /api/plc/status - Get all PLC data\n- GET  /api/plc/rpm - Get RPM only\n- GET  /api/plc/ballast - Get ballast only\n- GET  /api/plc/pump - Get pump status\n- POST /api/plc/write_register - Write register\n- POST /api/plc/write_coil - Write coil\n- POST /api/plc/pump/toggle - Toggle pump\n",
        "x": 210,
        "y": 40,
        "wires": []
    }
]
